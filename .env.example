# AIPETROS server configuration (copy to .env — never commit real secrets)
# No external AI API keys are required: all agents are 100% internal & deterministic.

# Server
PORT=3000
NODE_ENV=production

# CORS: comma-separated allowlist of extra origins (same-origin is always allowed)
CORS_ORIGINS=

# Set to 1 behind an HTTPS proxy to emit HSTS headers
FORCE_HSTS=0

# Local data directory (SQLite database lives here)
AIPETROS_DATA_DIR=.data
